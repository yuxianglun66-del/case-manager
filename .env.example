# 请把本文件复制为 .env 并修改里面的密码后使用
# cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，请勿提交到仓库

# ---------- 数据库（必填，务必改成强密码） ----------
# 用于 docker-compose 的 postgres 容器密码，以及 app 的 DATABASE_URL
DB_PASSWORD=please-change-me-strong-password

# ---------- 会话加密密钥（必填，务必改成一段随机长字符串） ----------
# 用于容器内 APP_SESSION_SECRET 及 http.Session 加密
SESSION_SECRET=please-change-me-session-secret-long-random

# ---------- 管理员初始密码（必填，仅首次启动初始化账号时使用） ----------
# 初始化后务必在系统内修改该密码
ADMIN_PASSWORD=please-change-me-admin-password

# ---------- 网站对外访问地址（可选，用于生成签署链接等绝对地址） ----------
# 形如 https://case.example.com 或 http://192.168.1.10:3000
APP_URL=http://localhost:3000

# 非容器本地开发时的同义变量（如用于签署链接拼接）
# APP_BASE_URL=http://localhost:3000

# ---------- 其他（可选） ----------
# 映射宿主端口（docker 端口映射，默认 3000）
APP_PORT=3000

# 单个附件大小上限（MB）
MAX_FILE_MB=50