# 请把本文件复制为 .env 并修改里面的密码后使用
# cp .env.example .env

# 数据库密码（务必改成强密码）
DB_PASSWORD=please-change-me-strong-password

# 会话加密密钥（务必改成一段随机长字符串）
SESSION_SECRET=please-change-me-session-secret-long-random

# 网站对外访问地址（如 https://anli.yourdomain.com）
APP_BASE_URL=http://localhost:8080

# 单个附件大小上限（MB）
MAX_FILE_MB=50
