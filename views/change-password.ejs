<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= title %> - 案件管理系统</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="logo-icon"><i class="bi bi-key-fill"></i></div>
      <h4 class="text-center mb-3 fw-bold"><%= title %></h4>
      <% if (typeof mustChange !== 'undefined' && mustChange) { %>
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> 首次登录，请修改默认密码后继续使用。</div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><i class="bi bi-x-circle"></i> <%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><i class="bi bi-check-circle"></i> 密码修改成功！<a href="/dashboard">返回首页</a></div>
      <% } else { %>
      <form method="POST" action="/change-password">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <% if (typeof mustChange === 'undefined' || !mustChange) { %>
        <div class="mb-3">
          <label class="form-label">旧密码</label>
          <input type="password" name="old_password" class="form-control" required>
        </div>
        <% } %>
        <div class="mb-3">
          <label class="form-label">新密码（至少8位）</label>
          <input type="password" name="new_password" class="form-control" minlength="8" required>
        </div>
        <div class="mb-3">
          <label class="form-label">确认新密码</label>
          <input type="password" name="confirm_password" class="form-control" minlength="8" required>
        </div>
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-lg"></i> 确认修改</button>
      </form>
      <% } %>
    </div>
  </div>
</body>
</html>
