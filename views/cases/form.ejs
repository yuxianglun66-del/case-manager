<div class="page-head">
  <div>
    <h1><%= mode === 'new' ? '新增案件' : '编辑案件' %></h1>
    <div class="lead"><%= caseData ? caseData.case_no : '' %></div>
  </div>
  <a href="/cases" class="btn btn-light"><i class="bi bi-arrow-left"></i> 返回列表</a>
</div>

<div class="card">
  <div class="card-body p-4">
    <form id="caseForm">
      <% if (mode === 'edit') { %><input type="hidden" name="case_id" value="<%= caseData.id %>"><% } %>

      <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
          <label class="form-label">案件类型 <span class="text-danger">*</span></label>
          <select class="form-select" name="case_type_id" id="caseTypeSelect">
            <% types.forEach(t => { %>
              <option value="<%= t.id %>" <%= caseTypeId === t.id ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12 col-md-8">
          <label class="form-label">案件名称 <span class="text-danger">*</span></label>
          <input type="text" name="title" class="form-control" placeholder="如：张某某交通事故理赔案" value="<%= caseData ? caseData.title : '' %>" required>
        </div>
      </div>

      <div class="form-section-title"><i class="bi bi-people"></i> 当事人</div>
      <div class="mb-4">
        <div class="table-responsive">
          <table class="table table-bordered mb-2" id="partyTable">
            <thead>
              <tr class="text-center small">
                <th style="width:90px">角色</th>
                <th style="width:170px">姓名 <span class="text-danger">*</span></th>
                <th style="width:150px">联系电话</th>
                <th style="width:180px">身份证号</th>
                <th style="width:70px"></th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-sm btn-outline-primary" onclick="addParty()"><i class="bi bi-plus-lg"></i> 添加当事人</button>
          <span class="text-muted small">保存后自动将第一位当事人姓名作为「客户/当事人」</span>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <label class="form-label">服务人员</label>
          <% if (can('cases.assign')) { %>
            <select name="assignee_id" class="form-select">
              <option value="">未分配</option>
              <% staff.forEach(s => { %>
                <option value="<%= s.id %>" <%= caseData && caseData.assignee_id === s.id ? 'selected' : '' %>><%= s.display_name %></option>
              <% }) %>
            </select>
          <% } else { %>
            <input type="text" class="form-control" value="<%= user.display_name %>" disabled>
            <input type="hidden" name="assignee_id" value="<%= user.id %>">
          <% } %>
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label">签单人员</label>
          <select name="sign_staff_id" class="form-select">
            <option value="">未分配</option>
            <% staffAll.forEach(s => { %>
              <option value="<%= s.id %>" <%= caseData && caseData.sign_staff_id === s.id ? 'selected' : '' %>><%= s.display_name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label">签单日期</label>
          <input type="date" name="sign_date" class="form-control" value="<%= caseData ? (caseData.sign_date || '') : '' %>">
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label">当前状态</label>
          <select name="status_id" class="form-select">
            <option value="">未设置</option>
            <% const STATUS_CATS = { signed:'已签约', processing:'理赔中', litigation:'诉讼中', closed:'已结案' }; %>
            <% const catGroups = {}; statuses.forEach(s => { (catGroups[s.category] = catGroups[s.category] || []).push(s); }); %>
            <% Object.keys(catGroups).forEach(cat => { %>
              <optgroup label="<%= STATUS_CATS[cat] || cat %>">
                <% catGroups[cat].forEach(s => { %>
                  <option value="<%= s.id %>" <%= caseData && caseData.status_id === s.id ? 'selected' : '' %>><%= s.name %></option>
                <% }) %>
              </optgroup>
            <% }) %>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label">服务费约定方式</label>
          <input type="text" name="fee_agreement" class="form-control" placeholder="如：按标的额5%收取，或按件计费500元/件" value="<%= caseData ? (caseData.fee_agreement || '') : '' %>">
        </div>
      </div>

      <div class="form-section-title"><i class="bi bi-file-earmark-text"></i> 案件信息</div>
      <div class="row gx-4" id="dynamicFields"></div>

      <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4"><%= mode === 'new' ? '保存案件' : '保存修改' %></button>
        <a href="<%= mode === 'edit' ? '/cases/' + caseData.id : '/cases' %>" class="btn btn-light">取消</a>
      </div>
    </form>
  </div>
</div>

<script>
  const FIELDS = <%- safeJson(fieldsByType) %>;
  const VALUES = <%- safeJson(values) %>;
  const PARTIES = <%- safeJson(parties || []) %>;
  const CASE_ID = <%- mode === 'edit' ? caseData.id : 'null' %>;
  const IS_EDIT = <%- mode === 'edit' ? 'true' : 'false' %>;

  const PARTY_ROLES = ['客户', '伤者', '被保险人', '投保人', '对方', '监护人', '其他'];

  function addParty(p) {
    p = p || {};
    const role = p.role || '';
    const options = `<option value="">请选择</option>` + PARTY_ROLES.map(r => `<option value="${r}" ${role === r ? 'selected' : ''}>${r}</option>`).join('');
    const tr = document.createElement('tr');
    tr.className = 'align-middle';
    tr.innerHTML = `
      <td><select class="form-select form-select-sm p-party-role" required>${options}</select></td>
      <td><input type="text" class="form-control form-control-sm p-party-name" placeholder="姓名（必填）" value="${(p.name || '').replace(/"/g, '&quot;')}"></td>
      <td><input type="tel" class="form-control form-control-sm p-party-phone" placeholder="联系电话" value="${(p.phone || '').replace(/"/g, '&quot;')}"></td>
      <td><input type="text" class="form-control form-control-sm p-party-id" placeholder="身份证号" value="${(p.id_card || '').replace(/"/g, '&quot;')}"></td>
      <td class="text-end"><button type="button" class="btn btn-ico btn-outline-danger" onclick="this.closest('tr').remove()"><i class="bi bi-trash"></i></button></td>
    `;
    if (p.id) tr.dataset.id = p.id;
    document.querySelector('#partyTable tbody').appendChild(tr);
  }

  function collectParties() {
    const rows = document.querySelectorAll('#partyTable tbody tr');
    const list = [];
    rows.forEach(tr => {
      const name = tr.querySelector('.p-party-name').value.trim();
      if (!name) return;
      const item = {
        name,
        role: tr.querySelector('.p-party-role').value,
        phone: tr.querySelector('.p-party-phone').value.trim(),
        id_card: tr.querySelector('.p-party-id').value.trim(),
      };
      if (tr.dataset.id) {
        item.id = parseInt(tr.dataset.id, 10);
        // 本表单只编辑 4 个基础字段；把详情页弹窗维护的扩展字段原样带回，
        // 防止 /api/cases/:id/update 的全字段 UPDATE 把它们覆盖为 null
        const orig = PARTIES.find(x => x.id === item.id);
        if (orig) {
          ['gender', 'age', 'address', 'contact_person', 'contact_phone', 'injury_info', 'hospital_dept', 'remark'].forEach(k => {
            if (orig[k] !== undefined && orig[k] !== null && orig[k] !== '') item[k] = orig[k];
          });
        }
      }
      list.push(item);
    });
    return list;
  }

  function renderFields(typeId) {
    const box = document.getElementById('dynamicFields');
    const fields = FIELDS[typeId] || [];
    if (fields.length === 0) {
      box.innerHTML = '<div class="col-12 text-muted small">该案件类型暂无自定义字段</div>';
      return;
    }
    box.innerHTML = fields.map(f => {
      const val = VALUES[f.id] || '';
      let control = '';
      const req = f.required ? '<span class="text-danger">*</span>' : '';
      let opts = [];
      try { opts = JSON.parse(f.options || '[]'); } catch (e) {}
      if (f.field_type === 'textarea') {
        control = `<textarea class="form-control" name="field_${f.id}" rows="3" placeholder="${(f.placeholder || '').replace(/"/g,'&quot;')}">${val}</textarea>`;
      } else if (f.field_type === 'select') {
        const os = opts.map(o => `<option value="${(o.label||'').replace(/"/g,'&quot;')}" ${val === o.label ? 'selected' : ''}>${o.label}</option>`).join('');
        control = `<select class="form-select" name="field_${f.id}"><option value="">请选择</option>${os}</select>`;
      } else if (f.field_type === 'date') {
        control = `<input type="date" class="form-control" name="field_${f.id}" value="${val}">`;
      } else if (f.field_type === 'number') {
        control = `<input type="number" step="any" class="form-control" name="field_${f.id}" value="${val}" placeholder="${(f.placeholder || '').replace(/"/g,'&quot;')}">`;
      } else {
        const it = f.field_type === 'phone' ? 'tel' : 'text';
        control = `<input type="${it}" class="form-control" name="field_${f.id}" value="${val}" placeholder="${(f.placeholder || '').replace(/"/g,'&quot;')}">`;
      }
      return `<div class="col-12 ${f.field_type === 'textarea' ? 'mt-1' : 'col-md-6'}"><div class="mb-3"><label class="form-label">${f.label} ${req}</label>${control}</div></div>`;
    }).join('');
  }

  const sel = document.getElementById('caseTypeSelect');
  sel.addEventListener('change', () => renderFields(parseInt(sel.value, 10)));
  renderFields(<%= caseTypeId || 0 %>);

  PARTIES.forEach(p => addParty(p));

  document.getElementById('caseForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type=submit]');
    btn.disabled = true;
    const fd = new FormData(e.target);
    const data = {};
    fd.forEach((v, k) => { data[k] = v; });
    const parties = collectParties();
    const noRole = parties.find(p => !p.role);
    if (noRole) { toast('请为当事人「' + noRole.name + '」选择角色', 'danger'); btn.disabled = false; return; }
    if (parties.length > 0) data.parties = JSON.stringify(parties);
    const url = IS_EDIT ? '/api/cases/' + CASE_ID + '/update' : '/api/cases/create';
    try {
      const r = await postJSON(url, data);
      toast('保存成功', 'success');
      setTimeout(() => location.href = '/cases/' + r.id, 400);
    } catch (err) {
      btn.disabled = false;
      toast(err.message, 'danger');
    }
  });
</script>
