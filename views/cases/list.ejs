<div class="page-head">
  <div>
    <h1>案件管理</h1>
    <div class="lead">共 <%= total %> 起案件</div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <% if (can('cases.create')) { %>
    <a href="/cases/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> 新增案件</a>
    <% } %>
    <% if (can('cases.import_export')) { %>
    <a href="javascript:void(0)" onclick="window.location='/api/cases/export/xlsx'+(location.search||'')" class="btn btn-success"><i class="bi bi-file-earmark-spreadsheet"></i> 导出 Excel</a>
    <a href="javascript:void(0)" onclick="window.location='/api/cases/export/csv'+(location.search||'')" class="btn btn-outline-success"><i class="bi bi-file-earmark-text"></i> 导出 CSV</a>
    <button class="btn btn-outline-secondary" onclick="openImportModal()"><i class="bi bi-upload"></i> 导入</button>
    <a href="/api/cases/import/template" class="btn btn-light border"><i class="bi bi-download"></i> 模板</a>
    <% if (can('cases.delete')) { %>
    <a href="/cases/recycle" class="btn btn-outline-secondary"><i class="bi bi-trash3"></i> 回收站</a>
    <% } %>
    <% } %>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body py-2">
    <div class="d-flex flex-wrap gap-2">
      <a href="/cases" class="btn btn-sm <%= !filters.cat ? 'btn-primary' : 'btn-outline-secondary' %>">全部案件</a>
      <a href="/cases?cat=pending" class="btn btn-sm <%= filters.cat === 'pending' ? 'btn-primary' : 'btn-outline-secondary' %>">待受理</a>
      <a href="/cases?cat=processing" class="btn btn-sm <%= filters.cat === 'processing' ? 'btn-primary' : 'btn-outline-secondary' %>">处理中</a>
      <a href="/cases?cat=litigation" class="btn btn-sm <%= filters.cat === 'litigation' ? 'btn-primary' : 'btn-outline-secondary' %>">诉讼中</a>
      <a href="/cases?cat=closed" class="btn btn-sm <%= filters.cat === 'closed' ? 'btn-primary' : 'btn-outline-secondary' %>">已结案/归档</a>
    </div>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header py-2"><i class="bi bi-funnel"></i> 筛选案件</div>
  <div class="card-body py-3">
    <form method="GET" action="/cases" class="row g-2 align-items-end">
      <div class="col-12 col-md-4 col-lg-3">
        <label class="form-label mb-1">关键词</label>
        <input type="text" name="kw" class="form-control" placeholder="搜索案号/名称/客户" value="<%= filters.kw %>">
      </div>
      <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label mb-1">类型</label>
        <select name="type" class="form-select">
          <option value="">全部类型</option>
          <% types.forEach(t => { %>
            <option value="<%= t.id %>" <%= filters.type === t.id ? 'selected' : '' %>><%= t.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label mb-1">状态</label>
        <select name="status" class="form-select">
          <option value="">全部状态</option>
          <% statuses.forEach(s => { %>
            <option value="<%= s.id %>" <%= filters.status === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <% if (can('cases.view_all') && staff.length) { %>
      <div class="col-6 col-md-3 col-lg-2">
        <label class="form-label mb-1">服务人员</label>
        <select name="assignee" class="form-select">
          <option value="">全部人员</option>
          <% staff.forEach(s => { %>
            <option value="<%= s.id %>" <%= filters.assignee === s.id ? 'selected' : '' %>><%= s.display_name %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <div class="col-12 col-md-4 col-lg-3">
        <label class="form-label mb-1">签单日期</label>
        <div class="d-flex gap-2 align-items-center">
          <input type="date" name="date_from" class="form-control" value="<%= filters.date_from || '' %>">
          <span class="text-muted">至</span>
          <input type="date" name="date_to" class="form-control" value="<%= filters.date_to || '' %>">
        </div>
      </div>
      <div class="col-12 col-md-auto d-flex gap-2">
        <button class="btn btn-primary"><i class="bi bi-search"></i> 搜索</button>
        <a href="/cases" class="btn btn-light"><i class="bi bi-arrow-counterclockwise"></i> 重置</a>
      </div>
    </form>
  </div>
</div>

<% if (can('cases.edit')) { %>
<div class="card mb-3">
  <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
    <span class="text-muted small me-1"><i class="bi bi-check2-square"></i> 批量操作：</span>
    <select id="batchStatus" class="form-select form-select-sm" style="width:150px">
      <option value="">变更状态…</option>
      <% statuses.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
    </select>
    <button class="btn btn-sm btn-primary" id="btnBatchStatus">应用状态</button>
    <% if (can('cases.view_all') && can('cases.assign') && staff.length) { %>
    <select id="batchAssignee" class="form-select form-select-sm" style="width:160px">
      <option value="">分配负责人…</option>
      <% staff.forEach(s => { %><option value="<%= s.id %>"><%= s.display_name %></option><% }) %>
    </select>
    <button class="btn btn-sm btn-outline-primary" id="btnBatchAssignee">分配</button>
    <% } %>
    <span class="badge rounded-pill border text-muted" id="batchCount" style="background:var(--surface)"><i class="bi bi-square-check"></i> 已选 0 项</span>
  </div>
</div>
<% } %>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <% if (can('cases.edit')) { %><th style="width:36px"><input type="checkbox" class="form-check-input" id="chkAllCases" title="全选"></th><% } %>
            <th>案号</th>
            <th>案件名称</th>
            <th>类型</th>
            <th>状态</th>
            <th class="hide-mobile">客户</th>
            <th class="hide-mobile">服务人员</th>
            <th class="hide-mobile">签单人员</th>
            <th class="hide-mobile">签单日期</th>
            <th class="text-center"><i class="bi bi-paperclip"></i></th>
            <th class="hide-mobile">下一步</th>
            <th class="hide-mobile">最近更新</th>
            <% if (can('cases.delete')) { %><th class="text-end">操作</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% cases.forEach(c => { %>
            <tr class="row-link" onclick="location.href='/cases/<%= c.id %>'">
              <% if (can('cases.edit')) { %>
              <td style="width:36px"><input type="checkbox" class="form-check-input chk-case" value="<%= c.id %>" onclick="event.stopPropagation(); updateBatchBar()"></td>
              <% } %>
              <td class="fw-bold" style="color:var(--bs-primary, #3b82f6) !important; letter-spacing:.3px"><%= c.case_no %></td>
              <td><%= c.title %></td>
              <td><span class="type-badge" style="background:<%= c.type_color %>"><%= c.type_name %></span></td>
              <td><span class="status-badge" style="background:<%= c.status_color || '#6c757d' %>"><%= c.status_name || '未设置' %></span></td>
              <td class="hide-mobile"><i class="bi bi-person text-muted me-1"></i><%= c.client_name || '—' %></td>
              <td class="hide-mobile"><i class="bi bi-briefcase text-muted me-1"></i><%= c.assignee_name || '—' %></td>
              <td class="hide-mobile"><i class="bi bi-person-check text-muted me-1"></i><%= c.sign_staff_name || '—' %></td>
              <td class="hide-mobile"><i class="bi bi-calendar-check text-muted me-1"></i><%= c.sign_date ? new Date(c.sign_date).toLocaleDateString('zh-CN') : '—' %></td>
              <td class="text-center"><span class="badge rounded-pill" style="background:rgba(59,130,246,.15);color:#60a5fa"><i class="bi bi-paperclip"></i> <%= c.file_count %></span></td>
              <td class="hide-mobile" style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%= c.next_action || '' %>"><%= c.next_action || '—' %></td>
              <td class="hide-mobile text-muted"><%= c.updated_at ? new Date(c.updated_at).toLocaleString('zh-CN') : '' %></td>
              <% if (can('cases.delete')) { %>
              <td class="text-end" style="width:50px"><button class="btn btn-ico btn-outline-danger" title="删除案件" onclick="event.stopPropagation(); delCase(<%= c.id %>, '<%= c.case_no.replace(/[\\'\"<>]/g,'') %>')"><i class="bi bi-trash"></i></button></td>
              <% } %>
            </tr>
          <% }) %>
          <% if (cases.length === 0) { %>
            <tr><td colspan="<%= can('cases.delete') ? 13 : 12 %>" class="empty-tip"><i class="bi bi-inbox"></i>没有符合条件的案件</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (totalPages > 1) { %>
    <div class="d-flex justify-content-between align-items-center p-3 border-top">
      <small class="text-muted">第 <%= page %> / <%= totalPages %> 页</small>
      <nav>
        <ul class="pagination pagination-sm">
          <% for (let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= p === page ? 'active' : '' %>">
              <a class="page-link" href="/cases?page=<%= p %>&kw=<%= encodeURIComponent(filters.kw) %>&type=<%= filters.type || '' %>&status=<%= filters.status || '' %>&assignee=<%= filters.assignee || '' %>&date_from=<%= filters.date_from || '' %>&date_to=<%= filters.date_to || '' %>&cat=<%= filters.cat || '' %>"><%= p %></a>
            </li>
          <% } %>
        </ul>
      </nav>
    </div>
    <% } %>
  </div>
</div>

<!-- ============ 导入弹窗 ============ -->
<div class="modal fade" id="importModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="importForm" enctype="multipart/form-data">
        <div class="modal-header py-2">
          <h6 class="modal-title">导入案件（CSV）</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-info small mb-3">
            <i class="bi bi-info-circle"></i> 请先下载<a href="/api/cases/import/template" class="ms-1">模板文件</a>，按格式填写后上传。<br>
            必填列：case_type_code（类型代码）、title（案件名称）、client_name（客户）、assignee_username（服务人员账号，可选）、status_name（状态名称）。
          </div>
          <div class="mb-3">
            <button type="button" class="btn btn-outline-primary w-100 mb-2" id="importPickBtn"><i class="bi bi-folder-plus"></i> 选择 CSV 文件</button>
            <input type="file" name="file" id="importFile" accept=".csv" required style="display:none">
            <div class="form-text">编码必须为 UTF-8（含 BOM 最佳）</div>
          </div>
        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> 开始导入</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openImportModal() {
    new bootstrap.Modal(document.getElementById('importModal')).show();
  }
  function selectedCaseIds() {
    return Array.from(document.querySelectorAll('.chk-case:checked')).map(el => Number(el.value));
  }
  function updateBatchBar() {
    const el = document.getElementById('batchCount');
    if (el) el.textContent = '✔ ' + selectedCaseIds().length + ' 项';
  }
  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('chkAllCases')?.addEventListener('change', function () {
      document.querySelectorAll('.chk-case').forEach(el => { el.checked = this.checked; });
      updateBatchBar();
    });
    document.getElementById('btnBatchStatus')?.addEventListener('click', async () => {
      const ids = selectedCaseIds();
      if (!ids.length) return toast('请先选择案件', 'warning');
      const statusId = document.getElementById('batchStatus').value;
      if (!statusId) return toast('请选择要变更的状态', 'warning');
      if (!(await confirmBox('确定将选中的 ' + ids.length + ' 个案件状态批量变更为所选状态？', '批量变更状态'))) return;
      try {
        const data = await postJSON('/api/cases/batch/status', { ids, status_id: parseInt(statusId, 10) });
        toast('已更新 ' + data.updated + ' 个案件状态', 'success');
        setTimeout(() => location.reload(), 500);
      } catch (err) { toast(err.message || '操作失败', 'danger'); }
    });
    document.getElementById('btnBatchAssignee')?.addEventListener('click', async () => {
      const ids = selectedCaseIds();
      if (!ids.length) return toast('请先选择案件', 'warning');
      const assigneeId = document.getElementById('batchAssignee').value;
      if (!assigneeId) return toast('请选择负责人', 'warning');
      if (!(await confirmBox('确定将选中的 ' + ids.length + ' 个案件分配给该负责人？', '批量分配'))) return;
      try {
        const data = await postJSON('/api/cases/batch/assignee', { ids, assignee_id: parseInt(assigneeId, 10) });
        toast('已分配 ' + data.updated + ' 个案件', 'success');
        setTimeout(() => location.reload(), 500);
      } catch (err) { toast(err.message || '操作失败', 'danger'); }
    });
  });
  async function delCase(id, caseNo) {
    if (!(await confirmBox('确定将案件「' + caseNo + '」移入回收站？可在回收站中恢复或彻底删除。', '删除案件'))) return;
    try {
      await postJSON('/api/cases/' + id + '/delete', {});
      toast('案件已移入回收站', 'success');
      setTimeout(() => location.reload(), 500);
    } catch (err) { toast(err.message || '删除失败', 'danger'); }
  }
  function pickFile(input) {
    try {
      if (input.showPicker) { input.showPicker(); return; }
    } catch (e) { /* fallthrough */ }
    input.click();
  }
  document.getElementById('importPickBtn').addEventListener('click', () => pickFile(document.getElementById('importFile')));
  document.getElementById('importForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = e.target.querySelector('input[type=file]');
    if (!input.files.length) return toast('请选择文件', 'danger');
    const fd = new FormData();
    fd.append('file', input.files[0]);
    const btn = e.target.querySelector('button[type=submit]');
    btn.disabled = true;
    try {
      const data = await postForm('/api/cases/import', fd);
      if (data.ok) {
        toast(`导入完成：成功 ${data.success} 条，失败 ${data.failed} 条`, data.failed ? 'warning' : 'success');
        if (data.errors?.length) console.warn('导入错误:', data.errors);
        bootstrap.Modal.getInstance(document.getElementById('importModal')).hide();
        setTimeout(() => location.reload(), 600);
      } else {
        toast(data.error || '导入失败', 'danger');
      }
    } catch (err) {
      btn.disabled = false;
      toast(err.message, 'danger');
    }
  });
</script>
