<%
  const roleColors = { 原告:'#4361ee', 被告:'#dc3545', 第三人:'#0ea5e9', 伤者:'#f59e0b', 用人单位:'#6f42c1', 保险公司:'#0d9488', 肇事方:'#ef4444', 受害人:'#e11d48', 其他:'#64748b' };
  const roleColor = r => roleColors[r] || '#64748b';
  const isImg = (a) => {
    const m = String(a.mime_type || '').toLowerCase();
    const n = String(a.original_name || '').toLowerCase();
    return m.startsWith('image/') || /\.(jpe?g|png|gif|bmp|webp|svg)$/.test(n);
  };
  const attGroups = {};
  const imgList = [];
  for (const a of attachments) {
    const k = (a.remark || '').trim() || '未分类';
    if (!attGroups[k]) attGroups[k] = [];
    attGroups[k].push(a);
    if (isImg(a)) imgList.push({ id: a.id, name: a.original_name });
  }
%>
<div class="page-head">
  <div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <h1 class="me-1"><%= caseData.case_no %></h1>
      <span class="type-badge" style="background:<%= caseData.type_color %>"><%= caseData.type_name %></span>
      <span class="status-badge" style="background:<%= caseData.status_color || '#6c757d' %>"><%= caseData.status_name || '未设置' %></span>
    </div>
    <div class="lead"><i class="bi bi-folder2-open me-1"></i><%= caseData.title %></div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <% if (can('cases.edit')) { %>
    <a href="/cases/<%= caseData.id %>/edit" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> 编辑</a>
    <% } %>
    <a href="/cases" class="btn btn-light"><i class="bi bi-arrow-left"></i> 返回</a>
  </div>
</div>

<div class="row g-3">
  <div class="col-12 col-lg-8">
    <div class="card mb-3">
      <div class="card-header"><i class="bi bi-info-circle"></i> 案件信息</div>
      <div class="card-body">
        <div class="info-grid">
          <div class="info-item">
            <div class="info-label"><i class="bi bi-file-earmark-text"></i> 案件名称</div>
            <div class="info-value"><%= caseData.title %></div>
          </div>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-person"></i> 客户/当事人</div>
            <div class="info-value"><%= caseData.client_name || '—' %></div>
          </div>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-person-badge"></i> 服务人员</div>
            <div class="info-value"><%= caseData.assignee_name || '—' %></div>
          </div>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-person-check"></i> 签单人员</div>
            <div class="info-value"><%= caseData.sign_staff_name || '—' %></div>
          </div>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-calendar-check"></i> 签单日期</div>
            <div class="info-value"><%= caseData.sign_date ? new Date(caseData.sign_date).toLocaleDateString('zh-CN') : '—' %></div>
          </div>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-calendar-plus"></i> 创建时间</div>
            <div class="info-value"><%= new Date(caseData.created_at).toLocaleString('zh-CN') %></div>
          </div>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-clock-history"></i> 最近更新</div>
            <div class="info-value"><%= new Date(caseData.updated_at).toLocaleString('zh-CN') %></div>
          </div>
          <% if (caseData.status_at) { %>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-arrow-repeat"></i> 状态更新时间</div>
            <div class="info-value"><%= new Date(caseData.status_at).toLocaleString('zh-CN') %></div>
          </div>
          <% } %>
          <div class="info-item">
            <div class="info-label"><i class="bi bi-person-plus"></i> 创建人</div>
            <div class="info-value"><%= caseData.creator_name || '—' %></div>
          </div>
        </div>

        <% if (fields.length) { %>
        <div class="form-section-title mt-4"><i class="bi bi-file-earmark-text"></i> 详细信息</div>
        <div class="info-grid">
          <% fields.forEach(f => { %>
            <div class="info-item">
              <div class="info-label"><%= f.label %></div>
              <div class="info-value"><%= values[f.id] || '—' %></div>
            </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>

    <!-- ============ 当事人 ============ -->
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-people"></i> 当事人（<span id="partyCount"><%= parties?.length || 0 %></span>）</span>
        <% if (can('parties.manage')) { %>
        <button class="btn btn-sm btn-primary" onclick="openPartyCreate()"><i class="bi bi-plus-lg"></i> 新增当事人</button>
        <% } %>
      </div>
      <div class="card-body">
        <div id="partyList">
          <% if (parties && parties.length) { %>
            <% parties.forEach(p => { %>
              <div class="party-item mb-2" id="party-<%= p.id %>">
                <div class="py-2 px-3">
                  <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="min-w-0">
                      <div class="fw-semibold d-flex align-items-center flex-wrap">
                        <span class="party-avatar"><%= p.name.charAt(0) %></span>
                        <span class="me-1"><%= p.name %></span>
                        <div class="d-flex align-items-center flex-wrap gap-1">
                        <span class="role-badge" style="background:<%= roleColor(p.role) %>"><%= p.role %></span>
                        <% if (p.gender) { %><span class="badge rounded-pill" style="background:rgba(59,130,246,.15);color:#60a5fa;font-size:11px"><%= p.gender === 'male' ? '男' : p.gender === 'female' ? '女' : p.gender %></span><% } %>
                        <% if (p.age) { %><span class="badge rounded-pill" style="background:rgba(16,185,129,.15);color:#34d399;font-size:11px"><%= p.age %>岁</span><% } %>
                      </div>
                      </div>
                      <div class="text-muted small mt-1">
                        <% if (p.id_card) { %><i class="bi bi-card-text"></i> <%= p.id_card %> · <% } %>
                        <% if (p.phone) { %><i class="bi bi-telephone"></i> <%= p.phone %> · <% } %>
                        <% if (p.address) { %><i class="bi bi-geo-alt"></i> <%= p.address %> · <% } %>
                        <% if (p.contact_person) { %><i class="bi bi-person-badge"></i> <%= p.contact_person %> <% if (p.contact_phone) { %>（<%= p.contact_phone %>）<% } %> · <% } %>
                        <% if (p.injury_info) { %><i class="bi bi-activity"></i> <%= p.injury_info %> · <% } %>
                        <% if (p.hospital_dept) { %><i class="bi bi-hospital"></i> <%= p.hospital_dept %> · <% } %>
                        <% if (p.remark) { %><i class="bi bi-chat-left-text"></i> <%= p.remark %> · <% } %>
                      </div>
                    </div>
                    <div class="d-flex gap-1 flex-shrink-0">
                      <% if (can('parties.manage')) { %>
                      <button class="btn btn-ico btn-light" title="编辑" onclick="openPartyEdit(<%= p.id %>)"><i class="bi bi-pencil"></i></button>
                      <button class="btn btn-ico btn-outline-danger" title="删除" onclick="delParty(<%= p.id %>, '<%= p.name.replace(/[\\'\"<>]/g, '') %>')"><i class="bi bi-trash"></i></button>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-tip"><i class="bi bi-people"></i>暂无当事人记录，点击「新增当事人」添加</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ============ 费用（结构化） ============ -->
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-cash"></i> 费用</span>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" onclick="toggleAgreement()" title="服务费约定"><i class="bi bi-file-text"></i></button>
          <% if (can('cases.fee')) { %>
          <button class="btn btn-sm btn-primary" onclick="openFeeModal()"><i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">新增</span></button>
          <% } %>
        </div>
      </div>
      <div class="card-body py-2">
        <div id="agreementBox" class="mb-3">
          <label class="form-label small fw-bold">服务费约定方式</label>
          <textarea id="feeAgreement" class="form-control form-control-sm" rows="2" placeholder="如：按标的额5%收取，或按件计费500元/件"><%= caseData.fee_agreement || '' %></textarea>
          <% if (can('cases.fee')) { %>
          <button class="btn btn-sm btn-outline-primary mt-1" onclick="saveAgreement()"><i class="bi bi-check-lg"></i> 保存约定</button>
          <% } %>
        </div>
        <div id="feeSummary" class="d-flex flex-wrap gap-3 small mb-2 fw-bold"></div>
        <div id="feeList"><div class="text-muted small">加载中…</div></div>
      </div>
    </div>

    <!-- 费用弹窗 -->
    <div class="modal fade" id="feeModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header py-2">
            <h6 class="modal-title" id="feeModalTitle">新增费用</h6>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" id="feeEditId">
            <div class="row g-2">
              <div class="col-6">
                <label class="form-label small">费用类型 *</label>
                <select id="feeType" class="form-select form-select-sm" required>
                  <option value="">请选择</option>
                  <option value="保全费">保全费</option>
                  <option value="鉴定费">鉴定费</option>
                  <option value="一审诉讼费">一审诉讼费</option>
                  <option value="二审诉讼费">二审诉讼费</option>
                  <option value="律师费">律师费</option>
                  <option value="差旅费">差旅费</option>
                  <option value="茶水费">茶水费</option>
                  <option value="公证费">公证费</option>
                  <option value="其他">其他</option>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label small">金额 *</label>
                <input type="number" id="feeAmount" class="form-control form-control-sm" step="0.01" min="0" required>
              </div>
              <div class="col-6">
                <label class="form-label small">状态</label>
                <select id="feeStatus" class="form-select form-select-sm">
                  <option value="pending">待支付</option>
                  <option value="paid">已支付</option>
                  <option value="advanced">垫付</option>
                  <option value="waived">减免</option>
                </select>
              </div>
              <div class="col-6">
                <label class="form-label small">付款方</label>
                <input type="text" id="feePayer" class="form-control form-control-sm" placeholder="如：委托人XX">
              </div>
              <div class="col-6">
                <label class="form-label small">日期</label>
                <input type="date" id="feePaidAt" class="form-control form-control-sm">
              </div>
              <div class="col-12">
                <label class="form-label small">备注</label>
                <input type="text" id="feeNote" class="form-control form-control-sm" placeholder="补充说明">
              </div>
              <div class="col-12">
                <label class="form-label small">截图/发票</label>
                <div class="d-flex align-items-center gap-2">
                  <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('feeFileInput').click()"><i class="bi bi-paperclip"></i> 选择文件</button>
                  <input type="file" id="feeFileInput" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp,.pdf" style="display:none">
                  <span id="feeFileName" class="text-muted small text-truncate" style="max-width:200px"></span>
                </div>
                <div id="feeFilePreview" class="mt-1"></div>
              </div>
            </div>
          </div>
          <div class="modal-footer py-2">
            <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">取消</button>
            <button type="button" class="btn btn-primary btn-sm" id="feeSaveBtn" onclick="saveFee()"><i class="bi bi-check-lg"></i> 保存</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ 电子合同 ============ -->
  <div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span><i class="bi bi-file-earmark-text"></i> 电子合同（<%= contracts?.length || 0 %>）</span>
      <% if (can('contracts.manage')) { %>
      <button class="btn btn-sm btn-primary" onclick="openContractCreate()"><i class="bi bi-plus-lg"></i> 发起签署</button>
      <% } %>
    </div>
    <div class="card-body">
      <div id="contractList">
        <% if (contracts && contracts.length) { %>
          <% contracts.forEach(c => { %>
            <div class="card mb-2" id="contract-<%= c.id %>">
              <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <div class="min-w-0">
                    <div class="fw-semibold d-flex align-items-center flex-wrap">
                      <i class="bi bi-file-earmark-text me-2" style="color:#4361ee"></i>
                      <span class="me-1"><%= c.title %></span>
                      <span class="role-badge" style="background:<%= c.status==='signed'?'#198754':c.status==='sent'?'#0d6efd':c.status==='revoked'?'#6c757d':'#ffc107' %>"><%= c.status==='signed'?'已完成':c.status==='sent'?'签署中':c.status==='revoked'?'已撤回':'草稿' %></span>
                    </div>
                    <div class="text-muted small mt-1"><i class="bi bi-collection me-1"></i>模板：<%= c.template_name || '—' %> · <i class="bi bi-send"></i>发起：<%= c.created_at ? new Date(c.created_at).toLocaleString('zh-CN') : '—' %></div>
                    <% if (c.signatures && c.signatures.length) { %>
                      <div class="text-muted small mt-1">
                        <% c.signatures.forEach(s => { %>
                          <span class="me-3"><i class="bi bi-person-check"></i> <%= s.party_name %> (<%= s.party_role %>): <span class="<%= s.status==='signed'?'text-success fw-semibold':'text-warning fw-semibold' %>"><%= s.status==='signed'?'已签署':'待签署' %></span><%= s.signed_at ? ' · ' + new Date(s.signed_at).toLocaleString('zh-CN') : '' %></span>
                        <% }) %>
                      </div>
                    <% } %>
                  </div>
                  <div class="d-flex gap-1 flex-shrink-0">
                    <% if (c.status === 'signed' && c.pdf_path) { %>
                      <a href="/api/contracts/<%= c.id %>/download" class="btn btn-ico btn-success" title="下载已签署合同"><i class="bi bi-download"></i></a>
                    <% } %>
                    <% if (c.status === 'sent') { %>
                      <button class="btn btn-ico btn-light" title="查看签署进度" onclick="viewContractProgress(<%= c.id %>)"><i class="bi bi-eye"></i></button>
                      <% if (can('contracts.manage')) { %>
                      <button class="btn btn-ico btn-outline-danger" title="撤回" onclick="revokeContract(<%= c.id %>)"><i class="bi bi-x-circle"></i></button>
                      <% } %>
                    <% } %>
                    <% if (typeof user !== 'undefined' && user && (user.role === 'super_admin' || user.role === 'admin')) { %>
                      <button class="btn btn-ico btn-outline-danger" title="删除合同" onclick="deleteContract(<%= c.id %>)"><i class="bi bi-trash"></i></button>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="empty-tip"><i class="bi bi-file-earmark-text"></i>暂无合同，点击「发起签署」创建</div>
        <% } %>
      </div>
    </div>
  </div>

    <!-- ============ 附件 ============ -->
    <style>
      .att-group { border:1px solid rgba(59,130,246,.15); border-radius:10px; margin-bottom:10px; background:rgba(15,23,42,.35); }
      .att-group > summary { list-style:none; cursor:pointer; padding:8px 12px; display:flex; align-items:center; gap:8px; font-weight:600; color:#e2e8f0; }
      .att-group > summary::-webkit-details-marker { display:none; }
      .att-group > summary::before { content:'\f4fe'; font-family:'bootstrap-icons'; font-size:.85rem; color:#818cf8; transition:transform .15s; }
      .att-group[open] > summary::before { content:'\f2ea'; }
      .att-group-count { background:rgba(99,102,241,.15); color:#a5b4fc; }
      .att-group-body { padding:0 12px 12px; }
      .att-thumbs { display:grid; grid-template-columns:repeat(auto-fill,minmax(88px,1fr)); gap:8px; margin-bottom:10px; }
      .att-thumb { position:relative; display:block; aspect-ratio:1/1; border-radius:8px; overflow:hidden; border:1px solid rgba(59,130,246,.2); background:#0f172a; }
      .att-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
      .lb-action { color:#e2e8f0; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.15); border-radius:8px; padding:5px 12px; font-size:.85rem; text-decoration:none; }
      .lb-action:hover { background:rgba(255,255,255,.18); color:#fff; }
      .lb-action.danger { color:#fca5a5; border-color:rgba(248,113,113,.4); }
      .lb-action.danger:hover { background:rgba(248,113,113,.18); color:#fecaca; }
      .lightbox { position:fixed; inset:0; z-index:1060; background:rgba(2,6,23,.92); display:flex; align-items:center; justify-content:center; flex-direction:column; touch-action:none; }
      .lightbox img { max-width:92vw; max-height:82vh; object-fit:contain; border-radius:6px; box-shadow:0 8px 40px rgba(0,0,0,.6); transform-origin:center center; transition:transform .05s; }
      .lb-close { position:absolute; top:14px; right:18px; font-size:1.6rem; color:#e2e8f0; cursor:pointer; padding:6px; }
      .lb-nav { position:absolute; top:50%; transform:translateY(-50%); background:rgba(15,23,42,.55); border:1px solid rgba(255,255,255,.35); color:#fff; font-size:2rem; width:52px; height:64px; border-radius:10px; display:flex; align-items:center; justify-content:center; cursor:pointer; box-shadow:0 2px 10px rgba(0,0,0,.4); backdrop-filter:blur(2px); }
      .lb-nav:hover { background:rgba(13,110,253,.85); border-color:rgba(255,255,255,.55); }
      .lb-prev { left:12px; } .lb-next { right:12px; }
      .lb-info { position:absolute; bottom:16px; left:0; right:0; text-align:center; color:#cbd5e1; font-size:.9rem; display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap; padding:0 10px; }
      .lb-zoom { display:inline-flex; gap:4px; align-items:center; }
      .lb-zbtn { background:rgba(15,23,42,.6); border:1px solid rgba(255,255,255,.3); color:#fff; width:32px; height:32px; border-radius:7px; display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:.9rem; padding:0; }
      .lb-zbtn:hover { background:rgba(13,110,253,.85); }
      .lb-zbtn.lb-zlabel { width:auto; min-width:56px; font-size:.8rem; background:rgba(255,255,255,.14); cursor:default; }
      .lb-zbtn.lb-zlabel:hover { background:rgba(255,255,255,.14); }
      .lb-dl { color:#93c5fd; text-decoration:none; }
      @media (max-width:576px) { .att-thumbs { grid-template-columns:repeat(auto-fill,minmax(64px,1fr)); } .lb-nav { width:44px; height:52px; font-size:1.6rem; background:rgba(15,23,42,.6); } .lb-zbtn { width:34px; height:34px; } }
    </style>

    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-paperclip"></i> 附件（<%= attachments.length %>）</span>
        <% if (attachments.length) { %>
        <a class="btn btn-sm btn-outline-primary" href="/api/cases/<%= caseData.id %>/attachments/zip"><i class="bi bi-download"></i> 打包下载</a>
        <% } %>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <% if (can('attachments.manage')) { %>
          <div id="pwaPickHint" class="small text-warning-emphasis d-none mb-1">
            <i class="bi bi-info-circle"></i> 若点击「选择文件」无反应，说明当前浏览器独立模式不支持文件选择，请改用 Chrome 浏览器添加到主屏幕后使用。
            <button type="button" class="btn-close btn-close-white d-inline-block align-middle ms-1" style="font-size:.5rem" onclick="document.getElementById('pwaPickHint').classList.add('d-none')" aria-label="关闭"></button>
          </div>
          <form id="uploadForm" class="d-flex gap-2 flex-wrap align-items-center">
            <button type="button" class="btn btn-outline-primary btn-sm" id="uploadPickBtn"><i class="bi bi-folder-plus"></i> 选择文件</button>
            <input type="file" name="files" id="uploadInput" multiple accept=".jpg,.jpeg,.png,.gif,.webp,.bmp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip,.rar,.7z" style="display:none">
            <input type="text" name="remark" id="uploadRemark" class="form-control" placeholder="备注（如：发票、病历、证明、认定书等）" style="max-width:260px">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-cloud-arrow-up"></i> 上传</button>
            <small class="text-muted">支持图片、Word、PDF、Excel、ZIP、RAR 等，单个不超过 <%= MAX_MB %>MB</small>
          </form>
          <% } %>
        </div>
        <div id="fileList">
          <% if (attachments.length === 0) { %>
            <div class="empty-tip"><i class="bi bi-paperclip"></i>暂无附件</div>
          <% } else { %>
            <% let gIdx = 0; %>
            <% for (const [gKey, gAtts] of Object.entries(attGroups)) { %>
            <details class="att-group" <%= gIdx === 0 ? 'open' : '' %>>
              <summary><%= gKey %><span class="badge rounded-pill att-group-count"><%= gAtts.length %></span></summary>
              <div class="att-group-body">
                <% const gImgs = gAtts.filter(isImg); %>
                <% if (gImgs.length) { %>
                <div class="att-thumbs">
                  <% gImgs.forEach(gi => { %>
                  <a class="att-thumb" href="javascript:void(0)" onclick="lbOpen(<%= imgList.findIndex(x => x.id === gi.id) %>)" title="<%= gi.original_name.replace(/["'<>]/g, '') %>">
                    <img src="/api/attachments/<%= gi.id %>/file" loading="lazy" alt="">
                  </a>
                  <% }) %>
                </div>
                <% } %>
                <% gAtts.filter(a => !isImg(a)).forEach(a => { %>
                <div class="file-item d-flex align-items-center gap-2 mb-2" id="file-<%= a.id %>">
                  <i class="bi bi-file-earmark-text fs-4" style="color:#4361ee"></i>
                  <div class="flex-grow-1 text-truncate">
                    <a href="/api/attachments/<%= a.id %>/preview" target="_blank" class="text-decoration-none fw-semibold"><%= a.original_name %></a>
                    <div class="text-muted small">
                      <i class="bi bi-database"></i> <%= (a.size / 1024).toFixed(1) %> KB · <i class="bi bi-person"></i> <%= a.uploader_name || '' %> · <i class="bi bi-clock"></i> <%= new Date(a.created_at).toLocaleString('zh-CN') %>
                    </div>
                  </div>
                  <div class="d-flex gap-1 flex-shrink-0">
                    <a href="/api/attachments/<%= a.id %>/preview" target="_blank" class="btn btn-ico btn-light" title="预览"><i class="bi bi-eye"></i></a>
                    <a href="/api/attachments/<%= a.id %>/download" class="btn btn-ico btn-light" title="下载"><i class="bi bi-download"></i></a>
                    <% if (can('attachments.manage')) { %>
                    <button class="btn btn-ico btn-light" title="替换文件" onclick="replaceFile(<%= a.id %>, '<%= a.original_name.replace(/[\\'\"<>]/g, '') %>')"><i class="bi bi-arrow-repeat"></i></button>
                    <button class="btn btn-ico btn-outline-danger" title="删除" onclick="delFile(<%= a.id %>)"><i class="bi bi-trash"></i></button>
                    <% } %>
                  </div>
                </div>
                <% }) %>
              </div>
            </details>
            <% gIdx++; %>
            <% } %>
          <% } %>
        </div>
      </div>
    </div>

    <!-- 图片灯箱 -->
    <div id="lightbox" class="lightbox" style="display:none">
      <div class="lb-close" onclick="lbClose()"><i class="bi bi-x-lg"></i></div>
      <button class="lb-nav lb-prev" onclick="lbNav(-1)"><i class="bi bi-chevron-left"></i></button>
      <img id="lbImg" src="" alt="">
      <button class="lb-nav lb-next" onclick="lbNav(1)"><i class="bi bi-chevron-right"></i></button>
      <div class="lb-info">
        <span id="lbInfo"></span>
        <span class="lb-zoom">
          <button type="button" class="lb-zbtn" onclick="lbZoom(-1)" title="缩小"><i class="bi bi-dash-lg"></i></button>
          <button type="button" class="lb-zbtn lb-zlabel" id="lbZoomLabel">100%</button>
          <button type="button" class="lb-zbtn" onclick="lbZoom(1)" title="放大"><i class="bi bi-plus-lg"></i></button>
          <button type="button" class="lb-zbtn" onclick="lbZoom(0)" title="重置为原始大小"><i class="bi bi-arrows-angle-out"></i></button>
          <button type="button" class="lb-zbtn" onclick="lbRotate()" title="旋转"><i class="bi bi-arrow-clockwise"></i></button>
        </span>
        <a id="lbDl" class="lb-dl" href="" target="_blank"><i class="bi bi-download"></i> 下载</a>
        <% if (can('attachments.manage')) { %>
        <button class="lb-action" id="lbReplace" onclick="lbReplaceCurrent()"><i class="bi bi-arrow-repeat"></i> 替换</button>
        <button class="lb-action danger" id="lbDelete" onclick="lbDeleteCurrent()"><i class="bi bi-trash"></i> 删除</button>
        <% } %>
      </div>
    </div>

  </div>

  <div class="col-12 col-lg-4">
    <div class="card mb-3">
      <div class="card-header"><i class="bi bi-arrow-repeat"></i> 更新进度</div>
      <div class="card-body">
        <% if (can('cases.edit')) { %>
        <form id="statusForm">
          <div class="mb-2">
            <select name="status_id" class="form-select" id="statusSelect">
              <% statuses.forEach(s => { %>
                <option value="<%= s.id %>" <%= caseData.status_id === s.id ? 'selected' : '' %>><%= s.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-2">
            <textarea name="note" class="form-control" rows="3" placeholder="填写本次进度说明（如：已提交理赔材料，等待审核）"></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check2-circle"></i> 更新状态</button>
        </form>
        <% } else { %>
          <div class="text-muted small">当前状态：<%= caseData.status_name || '未设置' %></div>
        <% } %>
      </div>
    </div>

    <!-- ============ 下一步流程（紧凑·内联编辑） ============ -->
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-arrow-repeat"></i> 下一步流程</span>
        <% if (can('cases.remind')) { %>
        <button class="btn btn-sm btn-outline-primary" id="naEditBtn" onclick="toggleNextActionEdit()"><i class="bi bi-pencil"></i> 更新</button>
        <% } %>
      </div>
      <div class="card-body py-2">
        <div id="naDisplay">
          <% if (caseData.next_action) { %>
            <div class="d-flex align-items-start gap-2">
              <i class="bi bi-check-circle-fill text-success mt-1"></i>
              <div class="min-w-0">
                <div class="small fw-semibold"><%= caseData.next_action %></div>
                <% if (caseData.reminder_at) {
                     const rd = new Date(caseData.reminder_at);
                     const rnow = new Date();
                     const rStartToday = new Date(rnow.getFullYear(), rnow.getMonth(), rnow.getDate());
                     const rEndToday = new Date(rnow.getFullYear(), rnow.getMonth(), rnow.getDate() + 1);
                     const overdue = rd < rStartToday;
                     const today = !overdue && rd < rEndToday;
                %>
                  <div class="text-muted small"><i class="bi bi-clock"></i> <%= rd.toLocaleString('zh-CN') %>
                    <% if (overdue) { %><span class="status-badge" style="background:#dc3545">已逾期</span><% } %>
                    <% if (!overdue && today) { %><span class="status-badge" style="background:#f59e0b">今天</span><% } %>
                    <% if (!overdue && !today) { %><span class="status-badge" style="background:#0ea5e9">即将</span><% } %>
                  </div>
                <% } %>
              </div>
            </div>
          <% } else { %>
            <div class="text-muted small">暂无下一步流程，点击「更新」设置</div>
          <% } %>
        </div>
        <div id="naEdit" style="display:none">
          <div class="mb-2">
            <textarea name="next_action" id="naNextAction" class="form-control form-control-sm" rows="2" placeholder="描述下一步要做什么"><%= caseData.next_action || '' %></textarea>
          </div>
          <div class="mb-2">
            <label class="form-label small">提醒时间</label>
            <input type="datetime-local" id="naReminderAt" class="form-control form-control-sm" value="<%= caseData.reminder_at ? new Date(caseData.reminder_at).toISOString().slice(0,16) : '' %>">
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-primary" onclick="saveNextAction()"><i class="bi bi-check-lg"></i> 保存</button>
            <button class="btn btn-sm btn-light" onclick="toggleNextActionEdit()"><i class="bi bi-x-lg"></i> 取消</button>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><i class="bi bi-clock-history"></i> 进度记录</div>
      <div class="card-body">
        <div class="timeline">
          <% history.forEach(h => { %>
            <div class="tl-item tl-<%= h.action %>">
              <div class="tl-title d-flex align-items-center justify-content-between gap-2">
                <span>
                  <%= h.action === 'created' ? '创建案件' : h.action === 'status' ? (h.status_name || '状态变更') : h.action === 'attachment' ? '附件操作' : h.action === 'attachment-del' ? '删除附件' : '更新信息' %>
                </span>
                <% if (typeof user !== 'undefined' && user && user.role === 'super_admin') { %>
                <button class="btn btn-ico btn-outline-danger" style="width:26px;height:26px;padding:0" title="删除此条进度记录" onclick="deleteHistory(<%= h.id %>)"><i class="bi bi-trash" style="font-size:12px"></i></button>
                <% } %>
              </div>
              <% if (h.note) { %><div class="tl-note"><%= h.note %></div><% } %>
              <div class="tl-time"><i class="bi bi-person"></i> <%= h.operator_name || '系统' %> · <%= new Date(h.created_at).toLocaleString('zh-CN') %></div>
            </div>
          <% }) %>
          <% if (history.length === 0) { %>
            <div class="empty-tip"><i class="bi bi-clock"></i>暂无进度记录</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============ 替换附件弹窗 ============ -->
<div class="modal fade" id="replaceModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title">替换附件</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="text-muted small mb-2" id="replaceName"></div>
        <button type="button" class="btn btn-outline-primary w-100" id="replacePickBtn"><i class="bi bi-folder-plus"></i> 选择新文件</button>
        <input type="file" id="replaceInput" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip,.rar,.7z" style="display:none">
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
        <button type="button" class="btn btn-primary" id="replaceOk">确认替换</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ 当事人弹窗 ============ -->
<div class="modal fade" id="partyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="partyForm">
        <div class="modal-header py-2">
          <h6 class="modal-title" id="partyModalTitle">新增当事人</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="party_id" id="pId">
          <div class="mb-3">
            <label class="form-label">姓名/名称 <span class="text-danger">*</span></label>
            <input type="text" name="name" id="pName" class="form-control" placeholder="如：张三 / 某某保险公司" required>
          </div>
          <div class="mb-3">
            <label class="form-label">角色 <span class="text-danger">*</span></label>
            <select name="role" id="pRole" class="form-select" required>
              <option value="">请选择</option>
              <option value="原告">原告</option>
              <option value="被告">被告</option>
              <option value="第三人">第三人</option>
              <option value="伤者">伤者</option>
              <option value="用人单位">用人单位</option>
              <option value="保险公司">保险公司</option>
              <option value="肇事方">肇事方</option>
              <option value="受害人">受害人</option>
              <option value="其他">其他</option>
            </select>
          </div>
          <div class="row g-3">
            <div class="col-6">
              <label class="form-label">性别</label>
              <select name="gender" id="pGender" class="form-select">
                <option value="">不限</option>
                <option value="male">男</option>
                <option value="female">女</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label">年龄</label>
              <input type="number" name="age" id="pAge" class="form-control" min="0" max="150" placeholder="岁">
            </div>
            <div class="col-6">
              <label class="form-label">身份证号</label>
              <input type="text" name="id_card" id="pIdCard" class="form-control">
            </div>
            <div class="col-6">
              <label class="form-label">联系电话</label>
              <input type="text" name="phone" id="pPhone" class="form-control">
            </div>
            <div class="col-12">
              <label class="form-label">地址</label>
              <input type="text" name="address" id="pAddress" class="form-control">
            </div>
            <div class="col-6">
              <label class="form-label">联系人（如公司代表）</label>
              <input type="text" name="contact_person" id="pContactPerson" class="form-control">
            </div>
            <div class="col-6">
              <label class="form-label">联系人电话</label>
              <input type="text" name="contact_phone" id="pContactPhone" class="form-control">
            </div>
            <div class="col-6">
              <label class="form-label">伤情</label>
              <input type="text" name="injury_info" id="pInjuryInfo" class="form-control" placeholder="如：左腿骨折、脑震荡等">
            </div>
            <div class="col-6">
              <label class="form-label">住院科室</label>
              <input type="text" name="hospital_dept" id="pHospitalDept" class="form-control" placeholder="如：骨科、神经外科等">
            </div>
            <div class="col-12">
              <label class="form-label">备注</label>
              <textarea name="remark" id="pRemark" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-12 d-flex align-items-end">
              <label class="form-label me-2">排序</label>
              <input type="number" name="sort" id="pSort" class="form-control" style="width:80px" value="0">
            </div>
          </div>
        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
          <button type="submit" class="btn btn-primary">保存</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const getAppUrl = () => window.location.origin;
  let replaceTarget = null;

  document.getElementById('uploadForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('uploadInput');
    if (!input.files.length) return toast('请选择文件', 'danger');
    const remark = document.getElementById('uploadRemark').value.trim();
    const fd = new FormData();
    for (const f of input.files) fd.append('files', f);
    if (remark) fd.append('remark', remark);
    const btn = e.target.querySelector('button[type=submit]');
    btn.disabled = true;
    try {
      await postForm('/api/cases/<%= caseData.id %>/attachments', fd);
      toast('上传成功', 'success');
      setTimeout(() => location.reload(), 500);
    } catch (err) {
      btn.disabled = false;
      toast(err.message, 'danger');
    }
  });

  /* 文件选择：优先 showPicker()（Chrome 99+），失败回退 click()，兼容各移动端外壳 */
  function pickFile(input) {
    try {
      if (input.showPicker) { input.showPicker(); return; }
    } catch (e) { /* 不支持/非手势上下文，继续走 click */ }
    input.click();
  }
  const uploadPickBtn = document.getElementById('uploadPickBtn');
  if (uploadPickBtn) uploadPickBtn.addEventListener('click', () => pickFile(document.getElementById('uploadInput')));
  const replacePickBtn = document.getElementById('replacePickBtn');
  if (replacePickBtn) replacePickBtn.addEventListener('click', () => pickFile(document.getElementById('replaceInput')));

  /* PWA 独立模式下提示可能不支持文件选择 */
  if (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) {
    const h = document.getElementById('pwaPickHint');
    if (h) h.classList.remove('d-none');
  }

  const statusFormEl = document.getElementById('statusForm');
  if (statusFormEl) statusFormEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type=submit]');
    btn.disabled = true;
    const data = {
      status_id: document.getElementById('statusSelect').value,
      note: e.target.note.value,
    };
    try {
      await postJSON('/api/cases/<%= caseData.id %>/status', data);
      toast('进度已更新', 'success');
      setTimeout(() => location.reload(), 400);
    } catch (err) {
      btn.disabled = false;
      toast(err.message, 'danger');
    }
  });

  async function delFile(id) {
    if (!(await confirmBox('确定删除该附件吗？删除后无法恢复。', '删除附件'))) return;
    try {
      await postJSON('/api/attachments/' + id + '/delete', {});
      toast('已删除', 'success');
      setTimeout(() => location.reload(), 300);
    } catch (err) { toast(err.message, 'danger'); }
  }

  function replaceFile(id, name) {
    replaceTarget = id;
    document.getElementById('replaceName').textContent = '原文件：' + name;
    document.getElementById('replaceInput').value = '';
    new bootstrap.Modal(document.getElementById('replaceModal')).show();
  }

  document.getElementById('replaceOk').addEventListener('click', async () => {
    const input = document.getElementById('replaceInput');
    if (!input.files.length) return toast('请选择文件', 'danger');
    const fd = new FormData();
    fd.append('file', input.files[0]);
    const btn = document.getElementById('replaceOk');
    btn.disabled = true;
    try {
      await postForm('/api/attachments/' + replaceTarget + '/replace', fd);
      bootstrap.Modal.getInstance(document.getElementById('replaceModal')).hide();
      toast('替换成功', 'success');
      setTimeout(() => location.reload(), 400);
    } catch (err) {
      btn.disabled = false;
      toast(err.message, 'danger');
    }
  });

  /* ============ 下一步流程（内联编辑） ============ */
  function toggleNextActionEdit() {
    const display = document.getElementById('naDisplay');
    const edit = document.getElementById('naEdit');
    if (!display || !edit) return;
    const isEditing = edit.style.display !== 'none';
    if (isEditing) {
      edit.style.display = 'none';
      display.style.display = '';
    } else {
      edit.style.display = '';
      display.style.display = 'none';
    }
  }
  async function saveNextAction() {
    const nextAction = document.getElementById('naNextAction').value.trim();
    const reminderAt = document.getElementById('naReminderAt').value || null;
    if (!nextAction) return toast('请填写下一步流程', 'warning');
    try {
      const res = await postJSON('/api/cases/<%= caseData.id %>/next-action', { next_action: nextAction, reminder_at: reminderAt });
      if (!res.ok) throw new Error((await res.json()).error || '更新失败');
      toggleNextActionEdit();
      toast('下一步流程已更新', 'success');
      setTimeout(() => location.reload(), 400);
    } catch (err) { toast(err.message, 'danger'); }
  }

  /* ============ 费用模块 ============ */
  const CAN_FEE = <%= can('cases.fee') ? 'true' : 'false' %>;
  const CAN_DELETE_FEE = <%= (user.role === 'super_admin' || user.role === 'admin') ? 'true' : 'false' %>;
  const CASE_ID = <%= caseData.id %>;
  const DIRECTION_LABELS = { income: '应收', expense: '应付' };
  const STATUS_LABELS = { pending: '待支付', paid: '已支付', advanced: '垫付', waived: '减免' };
  const STATUS_COLORS = { pending: 'warning', paid: 'success', advanced: 'info', waived: 'secondary' };

  function toggleAgreement() {
    const box = document.getElementById('agreementBox');
    box.style.display = box.style.display === 'none' ? '' : 'none';
  }
  async function saveAgreement() {
    const v = document.getElementById('feeAgreement').value.trim();
    try {
      const res = await postJSON('/api/cases/' + CASE_ID + '/fee', { fee_agreement: v || null });
      if (!res.ok) throw new Error('保存失败');
      toast('服务费约定已保存', 'success');
    } catch (e) { toast(e.message, 'danger'); }
  }

  async function loadFees() {
    try {
      const res = await fetch('/api/cases/' + CASE_ID + '/fees');
      const data = await res.json();
      const fees = data.fees || [];
      const s = data.summary || {};
      const incomeTotal = parseFloat(s.income_total) || 0;
      const expenseTotal = parseFloat(s.expense_total) || 0;
      const net = incomeTotal - expenseTotal;
      document.getElementById('feeSummary').innerHTML =
        '<span class="fw-bold" style="color:#198754">应收: ¥' + incomeTotal.toLocaleString('zh-CN', {minimumFractionDigits:2}) + '</span> &nbsp; ' +
        '<span class="fw-bold" style="color:#dc3545">应付: ¥' + expenseTotal.toLocaleString('zh-CN', {minimumFractionDigits:2}) + '</span> &nbsp; ' +
        '<span class="fw-bold">净: ¥' + net.toLocaleString('zh-CN', {minimumFractionDigits:2}) + '</span>';
      if (!fees.length) {
        document.getElementById('feeList').innerHTML = '<div class="empty-tip"><i class="bi bi-cash-stack"></i>暂无费用记录</div>';
        return;
      }
      document.getElementById('feeList').innerHTML =
        '<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr>' +
        '<th>类型</th><th class="text-end">金额</th>' +
        '<th class="d-none d-md-table-cell">付款方</th><th class="d-none d-sm-table-cell">状态</th>' +
        '<th class="d-none d-md-table-cell">日期</th><th></th></tr></thead><tbody>' +
        fees.map(f => '<tr>' +
          '<td>' + esc(f.fee_type) + (f.file_path ? ' <i class="bi bi-paperclip text-muted"></i>' : '') + '</td>' +
          '<td class="text-end">' +
            '<span style="display:inline-block;background:' + (f.direction === 'income' ? '#198754' : '#dc3545') + ';color:#fff;padding:2px 8px;border-radius:4px;font-weight:700;font-size:.95em">' +
            (f.direction === 'income' ? '+' : '-') + '¥' + parseFloat(f.amount).toLocaleString('zh-CN', {minimumFractionDigits:2}) +
            '</span></td>' +
          '<td class="d-none d-md-table-cell">' + esc(f.payer || '-') + '</td>' +
          '<td class="d-none d-sm-table-cell"><span class="badge bg-' + STATUS_COLORS[f.status] + '">' + STATUS_LABELS[f.status] + '</span></td>' +
          '<td class="d-none d-md-table-cell">' + (f.paid_at || '-') + '</td>' +
          '<td class="text-end text-nowrap">' +
            (f.file_path ? '<a href="/api/cases/' + CASE_ID + '/fees/' + f.id + '/file" target="_blank" class="btn btn-sm btn-outline-info py-0" title="查看附件"><i class="bi bi-eye"></i></a> ' : '') +
            (CAN_FEE ? '<button class="btn btn-sm btn-outline-primary py-0" onclick="editFee(' + f.id + ')" title="编辑"><i class="bi bi-pencil"></i></button> ' : '') +
            (CAN_DELETE_FEE ? '<button class="btn btn-sm btn-outline-danger py-0" onclick="deleteFee(' + f.id + ')" title="删除"><i class="bi bi-trash"></i></button>' : '') +
          '</td></tr>').join('') +
        '</tbody></table></div>';
    } catch (e) { document.getElementById('feeList').innerHTML = '<div class="text-danger small">加载失败</div>'; }
  }
  function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  function openFeeModal(fee) {
    document.getElementById('feeEditId').value = fee ? fee.id : '';
    document.getElementById('feeModalTitle').textContent = fee ? '编辑费用' : '新增费用';
    document.getElementById('feeType').value = fee ? fee.fee_type : '';
    document.getElementById('feeAmount').value = fee ? fee.amount : '';
    document.getElementById('feeStatus').value = fee ? fee.status : 'pending';
    document.getElementById('feePayer').value = fee ? (fee.payer || '') : '';
    document.getElementById('feePaidAt').value = fee ? (fee.paid_at || '') : '';
    document.getElementById('feeNote').value = fee ? (fee.note || '') : '';
    document.getElementById('feeFileInput').value = '';
    document.getElementById('feeFileName').textContent = fee && fee.file_original_name ? fee.file_original_name : '';
    var preview = document.getElementById('feeFilePreview');
    if (fee && fee.file_path && fee.file_mime && fee.file_mime.startsWith('image/')) {
      preview.innerHTML = '<img src="/api/cases/' + CASE_ID + '/fees/' + fee.id + '/file" style="max-height:80px;border-radius:4px">';
    } else { preview.innerHTML = ''; }
    new bootstrap.Modal(document.getElementById('feeModal')).show();
  }

