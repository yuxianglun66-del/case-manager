  /* ---- 合同管理 ---- */
  function openContractCreate() {
    fetch('/api/contract-templates').then(r=>r.json()).then(d=>{
      const tpls = d.templates || [];
      if (!tpls.length) return toast('请先在系统设置上传合同模板', 'warning');
      const parties = <%- safeJson(parties || []) %>;
      let html = '<div class="mb-3"><label class="form-label">选择模板</label><select id="ctTemplateId" class="form-select"><option value="">请选择</option>';
      tpls.forEach(t=>html+=`<option value="${t.id}">${t.name}${t.type_name?'（'+t.type_name+'）':''}</option>`);
      html += '</select></div>';
      html += '<div class="mb-3"><label class="form-label">合同标题</label><input type="text" id="ctTitle" class="form-control" placeholder="如：王小明交通事故调解协议书" required></div>';
      html += '<div class="mb-3"><label class="form-label">签署当事人</label><select id="ctPartyIds" class="form-select" multiple size="' + Math.min(6, (parties.length||1)) + '">';
      parties.forEach(p=>html+=`<option value="${p.id}">${p.name}（${p.role}）</option>`);
      html += '</select><div class="form-text">按模板签名位置顺序选择，按住 Ctrl 可多选</div></div>';
      const mb = modalBox('发起合同签署', html, { okText: '创建并发送' });
      mb.show();
      mb.okBtn.addEventListener('click', async () => {
        const template_id = document.getElementById('ctTemplateId').value;
        const title = document.getElementById('ctTitle').value.trim();
        const party_ids = Array.from(document.getElementById('ctPartyIds').selectedOptions).map(o=>Number(o.value));
        if (!template_id || !title || !party_ids.length) return toast('请填写完整', 'warning');
        mb.okBtn.disabled = true;
        try {
          const csrf2 = getCsrfToken();
          const res = await fetch('/api/cases/<%= caseData.id %>/contracts', {method:'POST',headers:{'Content-Type':'application/json',...(csrf2?{'x-csrf-token':csrf2}:{}),},body:JSON.stringify({template_id:parseInt(template_id),title,party_ids})});
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || '创建失败');
          mb.close();
          toast('合同已发起，签署链接已生成', 'success');
          setTimeout(()=>location.reload(),500);
        } catch(err) { mb.okBtn.disabled = false; toast(err.message, 'danger'); }
      });
    });
  }
  async function viewContractProgress(id) {
    const res = await fetch('/api/cases/<%= caseData.id %>/contracts');
    const data = await res.json();
    const c = data.contracts.find(x=>x.id===id);
    if (!c) return;
    let html = '<div class="text-start"><h6>' + c.title + '</h6><table class="table table-sm"><thead><tr><th>当事人</th><th>角色</th><th>状态</th><th>签署时间</th></tr></thead><tbody>';
    c.signatures.forEach(s=>html+=`<tr><td>${s.party_name}</td><td>${s.party_role}</td><td><span class="badge ${s.status==='signed'?'bg-success':'bg-warning'}">${s.status==='signed'?'已签署':'待签署'}</span></td><td>${s.signed_at?new Date(s.signed_at).toLocaleString('zh-CN'):'—'}</td></tr>`);
    html += '</tbody></table></div>';
    const mb = modalBox('签署进度', html, { okText: '关闭', footer: true });
    mb.show();
    mb.okBtn.addEventListener('click', () => mb.close());
    if (c.status === 'sent') {
      const t = c.signatures && c.signatures[0] && c.signatures[0].sign_token;
      if (t) {
        let links = '<hr><div class="text-start small">签署链接：</div>';
        links += `<div class="input-group input-group-sm mt-1"><input class="form-control form-control-sm" readonly value="${getAppUrl()}/sign/${t}"><button class="btn btn-outline-secondary btn-sm" onclick="copySignLink(this)" data-token="${t}">复制</button></div>`;
        links += '<div class="text-muted small mt-1">把此链接发给当事人，当事人与代理人在同一页面依次签名后一次性提交。</div>';
        const extra = document.createElement('div');
        extra.innerHTML = links;
        mb.body.appendChild(extra);
      }
    }
  }
  function copyToClipboard(text) {
    return new Promise((resolve) => {
      const fallback = () => {
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.top = '-1000px';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.focus();
          ta.select();
          let ok = false;
          try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
          document.body.removeChild(ta);
          if (ok) return resolve(true);
        } catch (e) {}
        try { window.prompt('复制链接：', text); return resolve(true); } catch (e) { resolve(false); }
      };
      if (navigator.clipboard && window.isSecureContext && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => resolve(true)).catch(() => fallback());
      } else {
        fallback();
      }
    });
  }
  async function copySignLink(btn) {
    const url = btn.dataset.token ? getAppUrl() + '/sign/' + btn.dataset.token : btn.value;
    const ok = await copyToClipboard(url);
    toast(ok ? '链接已复制' : '复制失败', ok ? 'success' : 'danger');
  }
