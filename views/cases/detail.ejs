  async function saveFee() {
    var id = document.getElementById('feeEditId').value;
    var fd = new FormData();
    fd.append('fee_type', document.getElementById('feeType').value);
    fd.append('amount', document.getElementById('feeAmount').value);
    fd.append('status', document.getElementById('feeStatus').value);
    fd.append('payer', document.getElementById('feePayer').value);
    fd.append('paid_at', document.getElementById('feePaidAt').value);
    fd.append('note', document.getElementById('feeNote').value);
    var fileInput = document.getElementById('feeFileInput');
    if (fileInput.files.length) fd.append('file', fileInput.files[0]);
    var btn = document.getElementById('feeSaveBtn');
    btn.disabled = true;
    try {
      var url = id ? '/api/cases/' + CASE_ID + '/fees/' + id : '/api/cases/' + CASE_ID + '/fees';
      var csrf = getCsrfToken();
      var res = await fetch(url, { method: id ? 'PUT' : 'POST', body: fd, headers: csrf ? {'x-csrf-token': csrf} : {} });
      var j = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(j.error || '保存失败');
      bootstrap.Modal.getInstance(document.getElementById('feeModal')).hide();
      toast('费用已保存', 'success');
      _feesCache = [];
      loadFees();
    } catch (e) { toast(e.message, 'danger'); }
    finally { btn.disabled = false; }
  }

