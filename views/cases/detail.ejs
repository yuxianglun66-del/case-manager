        <div class="party-item mb-2" id="party-${p.id}">
          <div class="py-2 px-3">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div class="min-w-0">
                <div class="fw-semibold d-flex align-items-center flex-wrap">
                  <span class="party-avatar">${p.name.charAt(0)}</span>
                  <span class="me-1">${p.name}</span>
                  <span class="role-badge" style="background:${roleColor(p.role)}">${p.role}</span>
                  ${p.gender ? `<span class="badge rounded-pill" style="background:rgba(59,130,246,.15);color:#60a5fa;font-size:11px">${p.gender === 'male' ? '男' : p.gender === 'female' ? '女' : p.gender}</span>` : ''}
                  ${p.age ? `<span class="badge rounded-pill" style="background:rgba(16,185,129,.15);color:#34d399;font-size:11px">${p.age}岁</span>` : ''}
                </div>
                <div class="text-muted small mt-1">
                  ${p.id_card ? `<i class="bi bi-card-text"></i> ${p.id_card} · ` : ''}
                  ${p.phone ? `<i class="bi bi-telephone"></i> ${p.phone} · ` : ''}
                  ${p.address ? `<i class="bi bi-geo-alt"></i> ${p.address} · ` : ''}
                  ${p.contact_person ? `<i class="bi bi-person-badge"></i> ${p.contact_person}${p.contact_phone ? '（' + p.contact_phone + '）' : ''} · ` : ''}
                  ${p.injury_info ? `<i class="bi bi-activity"></i> ${p.injury_info} · ` : ''}
                  ${p.hospital_dept ? `<i class="bi bi-hospital"></i> ${p.hospital_dept} · ` : ''}
