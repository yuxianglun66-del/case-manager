<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>忘记密码 - 案件管理系统</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="login-logo">
        <div class="logo-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <span>忘记密码</span>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-circle"></i> <%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success py-2 small"><i class="bi bi-check-circle"></i> <%= success %></div>
      <% } %>

      <% if (step === 'username') { %>
        <!-- 第一步：输入用户名和安全答案 -->
        <form method="POST" action="/forgot-password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="step" value="verify">
          <div class="mb-3">
            <label class="form-label">用户名</label>
            <input type="text" name="username" class="form-control" required autofocus placeholder="请输入您的用户名" value="<%= username %>">
          </div>
          <div class="mb-4">
            <label class="form-label">安全答案</label>
            <input type="text" name="security_answer" class="form-control" required placeholder="请输入安全问题的答案">
          </div>
          <button type="submit" class="btn btn-primary w-100">验证身份</button>
        </form>
      <% } else if (step === 'reset') { %>
        <!-- 第二步：设置新密码 -->
        <div class="mb-3 text-muted small">
          <i class="bi bi-question-circle"></i> 安全问题：<strong><%= securityQuestion %></strong>
        </div>
        <form method="POST" action="/forgot-password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="step" value="reset">
          <input type="hidden" name="userId" value="<%= userId %>">
          <input type="hidden" name="username" value="<%= username %>">
          <div class="mb-3">
            <label class="form-label">新密码</label>
            <input type="password" name="new_password" class="form-control" required minlength="8" autofocus placeholder="至少 8 位">
          </div>
          <div class="mb-4">
            <label class="form-label">确认新密码</label>
            <input type="password" name="confirm_password" class="form-control" required minlength="8" placeholder="再次输入新密码">
          </div>
          <button type="submit" class="btn btn-primary w-100">重置密码</button>
        </form>
      <% } else { %>
        <!-- 完成 -->
        <div class="text-center my-4">
          <i class="bi bi-check-circle text-success" style="font-size:3rem"></i>
        </div>
        <a href="/login" class="btn btn-primary w-100">返回登录</a>
      <% } %>

      <div class="login-tip"><a href="/login" style="color:inherit"><i class="bi bi-arrow-left"></i> 返回登录</a></div>
    </div>
  </div>
</body>
</html>
