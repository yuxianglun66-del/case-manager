<link href="/vendor/quill/quill.snow.css" rel="stylesheet">
<script src="/vendor/quill/quill.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<style>
  .lib-md-body h1,.lib-md-body h2,.lib-md-body h3,.lib-md-body h4 { margin-top:.5rem; margin-bottom:.3rem; }
  .lib-md-body p { margin-bottom:.4rem; }
  .lib-md-body ul,.lib-md-body ol { padding-left:1.2rem; margin-bottom:.4rem; }
  .lib-md-body code { background:#f1f3f5; padding:1px 4px; border-radius:3px; font-size:.85em; }
  .lib-md-body pre { background:#f8f9fa; padding:.5rem; border-radius:4px; overflow:auto; }
  .lib-md-body blockquote { border-left:3px solid var(--bs-primary); padding-left:.6rem; margin:.4rem 0; color:#555; background:#f8f9fa; padding:.3rem .6rem; border-radius:0 4px 4px 0; }
  .lib-md-body table { border-collapse:collapse; width:100%; margin:.4rem 0; }
  .lib-md-body th,.lib-md-body td { border:1px solid #dee2e6; padding:4px 8px; font-size:.85rem; }
  .lib-md-body th { background:#e9ecef; }
  .lib-content-box { background:#f8f9fa; border-radius:4px; padding:.5rem .7rem; border:1px solid #e9ecef; }
  .lib-content-box img { max-width:100%; height:auto; }
  .lib-content-truncate { cursor:pointer; transition: background .15s; }
  .lib-content-truncate:hover { background:#e9ecef; }
  #quillEditor { min-height:180px; font-size:.9rem; }
  .ql-toolbar.ql-snow { border-radius:4px 4px 0 0; }
  .ql-container.ql-snow { border-radius:0 0 4px 4px; }
  #libContentModal .modal-body { max-height:70vh; overflow:auto; font-size:.9rem; line-height:1.7; color:#212529; background:#fff; }
  #libContentModal .modal-content { background:#fff; color:#212529; }
  #libContentModal .modal-body img { max-width:100%; height:auto; }
  #libContentModal .modal-body table { width:100%; border-collapse:collapse; margin:.4rem 0; }
  #libContentModal .modal-body th, #libContentModal .modal-body td { border:1px solid #dee2e6; padding:4px 8px; font-size:.85rem; }
  #libContentModal .modal-body th { background:#e9ecef; }
  #libContentModal .modal-body blockquote { border-left:3px solid var(--bs-primary); padding-left:.6rem; margin:.4rem 0; color:#555; background:#f8f9fa; padding:.3rem .6rem; border-radius:0 4px 4px 0; }
  #libContentModal .modal-body pre { background:#f1f3f5; padding:.5rem; border-radius:4px; overflow:auto; }
  #libContentModal .modal-body code { background:#f1f3f5; padding:1px 4px; border-radius:3px; font-size:.85em; }

  /* ============ 分类胶囊 + 分组区块 ============ */
  .lib-pill { display:inline-flex; align-items:center; gap:6px; padding:.2rem .7rem; font-size:.8rem; line-height:1.6; border:1px solid var(--content-border, #ced4da); border-radius:999px; background:transparent; color:inherit; cursor:pointer; transition:border-color .12s, box-shadow .12s; }
  .lib-pill:hover { border-color: var(--bs-primary); }
  .lib-pill .p-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
  .lib-pill .p-cnt { font-size:.7rem; font-weight:600; padding:0 .5em; border-radius:999px; background:rgba(148,163,184,.22); }
  .lib-pill.active { box-shadow: 0 0 0 1px rgba(59,130,246,.15); }
  .lib-section { margin-bottom:1rem; }
  .lib-sec-head { position:sticky; top:0; z-index:1010; cursor:pointer; user-select:none; transition:none; }
  .lib-sec-head.card:hover { transform:none; }
  .lib-sec-head .card-body { padding:.55rem .75rem; }
  .lib-sec-chevron { font-size:.85rem; color:var(--content-muted, #94a3b8); transition:transform .15s; }
  .lib-section.collapsed .lib-sec-chevron { transform:rotate(-90deg); }
  .lib-sec-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; box-shadow:0 0 0 2px rgba(148,163,184,.2); }
  .lib-sec-cnt { font-size:.72rem; font-weight:600; padding:.05em .55em; border-radius:999px; background:rgba(148,163,184,.22); color:inherit; }
  @media (max-width: 991.98px) { .lib-sec-head { top:50px; } } /* 让开移动端吸顶 topbar */
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="mb-0"><i class="bi bi-book-half"></i> 法律法规库</h4>
  <% if (canEdit) { %>
    <button class="btn btn-primary btn-sm" onclick="openLibModal()"><i class="bi bi-plus-lg"></i> 新增</button>
  <% } %>
</div>

<div class="card mb-3">
  <div class="card-body py-2">
    <div class="d-flex gap-2 flex-wrap align-items-center">
      <div class="d-flex gap-1 flex-wrap align-items-center" id="libPills" role="group" aria-label="分类筛选"></div>
      <div class="d-flex gap-2 ms-auto">
        <input type="text" class="form-control form-control-sm" id="libFilterKey" placeholder="搜索标题/内容..." style="max-width:240px">
        <button class="btn btn-outline-primary btn-sm" onclick="loadLibrary()" title="搜索"><i class="bi bi-search"></i></button>
      </div>
    </div>
  </div>
</div>

<div id="libList"></div>

<% if (canEdit) { %>
<div class="modal fade" id="libModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title" id="libModalTitle">新增</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="libEditId">
        <div class="mb-2"><label class="form-label small">标题 *</label><input type="text" class="form-control form-control-sm" id="libTitle" required></div>
        <div class="mb-2"><label class="form-label small">分类 *</label><select class="form-select form-select-sm" id="libCategory"></select></div>
        <div class="mb-2">
          <label class="form-label small">文本内容</label>
          <div id="quillEditor"></div>
        </div>
        <div class="mb-2"><label class="form-label small">附件</label><input type="file" class="form-control form-control-sm" id="libFile" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip,.rar,.7z"><div class="form-text">支持图片、PDF、Word、Excel、文本等格式</div></div>
      </div>
      <div class="modal-footer py-2">
      <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
      <button type="button" class="btn btn-primary" id="libSaveBtn" onclick="saveLibItem()"><i class="bi bi-check-lg"></i> 保存</button>
      </div>
    </div>
  </div>
</div>
<% } %>

<div class="modal fade" id="libContentModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title" id="libContentModalTitle"></h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body lib-md-body" id="libContentModalBody"></div>
    </div>
  </div>
</div>

<script>
var libItems = <%- JSON.stringify(items) %>;
var libCatsData = <%- JSON.stringify(categories) %>;
var libCats = libCatsData.map(function(c) { return c.name; });
var libCatColors = {};
libCatsData.forEach(function(c) { libCatColors[c.name] = c.color; });
var canEditLib = <%= canEdit %>;
var libFilterCat = '';   /* 当前选中的分类胶囊（''=全部） */
var libCollapsed = {};   /* 分组折叠状态，按分类名记忆 */
try { libCollapsed = JSON.parse(localStorage.getItem('libCollapsed') || '{}') || {}; } catch (e) { libCollapsed = {}; }
var quillInstance = null;

function renderContent(text) {
  if (!text) return '';
  var trimmed = text.trim();
  if (trimmed.charAt(0) === '<') return trimmed;
  if (typeof marked !== 'undefined') return marked.parse(trimmed);
  return trimmed.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
}

function initQuill() {
  if (quillInstance) return;
  if (typeof Quill === 'undefined') return;
  quillInstance = new Quill('#quillEditor', {
    theme: 'snow',
    placeholder: '输入内容...',
    modules: {
      toolbar: [
        [{ 'header': [1, 2, 3, 4, false] }],
        [{ 'font': [] }, { 'size': ['small', false, 'large', 'huge'] }],
        ['bold', 'italic', 'underline', 'strike'],
        [{ 'color': [] }, { 'background': [] }],
        [{ 'align': [] }],
        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
        ['blockquote', 'code-block'],
        ['link', 'image'],
        ['clean']
      ]
    }
  });
}

function escLib(s) {
  /* 用拼接写实体，防止源码里的 & 等被转义链吞掉 */
  var t = String(s == null ? '' : s);
  return t.split('&').join('&' + 'amp;')
          .split('<').join('&' + 'lt;')
          .split('>').join('&' + 'gt;')
          .split('"').join('&' + 'quot;');
}

function libLuminanceFg(hex) {
  try {
    var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
    return ((0.299*r + 0.587*g + 0.114*b) / 255) > 0.5 ? '#000' : '#fff';
  } catch (e) { return '#fff'; }
}

(function() {
  var catSel = document.getElementById('libCategory');
  if (catSel) libCats.forEach(function(c) { var o = document.createElement('option'); o.value = c; o.textContent = c; catSel.appendChild(o); });
  document.getElementById('libPills').addEventListener('click', function(e) {
    var b = e.target.closest('.lib-pill'); if (!b) return;
    libFilterCat = b.dataset.cat;
    loadLibrary();
  });
  var fk = document.getElementById('libFilterKey');
  fk.addEventListener('keydown', function(e) { if (e.key === 'Enter') loadLibrary(); });
  loadLibrary();
})();

function renderLibPills(sf) {
  var counts = {}, total = sf.length;
  libCats.forEach(function(c) { counts[c] = 0; });
  var orphans = {};
  sf.forEach(function(it) {
    var c = it.category || '未分类';
    if (counts.hasOwnProperty(c)) counts[c]++;
    else orphans[c] = (orphans[c] || 0) + 1;
  });
  function pill(cat, label, cnt, color) {
    var active = libFilterCat === cat;
    var bg = color || 'var(--bs-primary)';
    var st = active ? ' style="background:' + bg + ';border-color:' + bg + ';color:' + (color ? libLuminanceFg(color) : '#fff') + '"' : '';
    var dot = color ? '<span class="p-dot" style="background:' + color + '"></span>' : '';
    var cntSt = active ? ' style="background:rgba(255,255,255,.25)"' : '';
    return '<button type="button" class="lib-pill' + (active ? ' active' : '') + '" data-cat="' + escLib(cat) + '"' + st + '>' + dot + escLib(label) + '<span class="p-cnt"' + cntSt + '>' + cnt + '</span></button>';
  }
  var html = pill('', '全部', total, null);
  libCats.forEach(function(c) { html += pill(c, c, counts[c], libCatColors[c] || '#6c757d'); });
  Object.keys(orphans).forEach(function(c) { if (!counts.hasOwnProperty(c)) html += pill(c, c, orphans[c], libCatColors[c] || '#6c757d'); });
  document.getElementById('libPills').innerHTML = html;
}

function libItemCard(it) {
  var hasFile = it.file_path;
  var dateStr = String(it.created_at).slice(0, 10);
  var h = '<div class="col-12 col-lg-6"><div class="card h-100"><div class="card-body py-2 px-3">';
  h += '<div class="d-flex justify-content-between align-items-start gap-2">';
  h += '<div class="fw-semibold" style="min-width:0"><span style="word-break:break-all">' + escLib(it.title || '') + '</span>' + (hasFile ? ' <i class="bi bi-paperclip text-muted" title="附件"></i>' : '') + '</div>';
  if (canEditLib) {
    h += '<div class="d-flex gap-1 flex-shrink-0">'
      + '<button class="btn btn-ico btn-ico-sm btn-light" title="编辑" onclick="editLibItem(' + it.id + ')"><i class="bi bi-pencil-fill"></i></button>'
      + '<button class="btn btn-ico btn-ico-sm btn-outline-danger" title="删除" onclick="deleteLibItem(' + it.id + ')"><i class="bi bi-trash"></i></button>'
      + '</div>';
  }
  h += '</div>';
  if (hasFile) {
    h += '<div class="mt-2 d-flex align-items-center gap-2 flex-wrap">'
      + '<a href="/api/library/' + it.id + '/preview" target="_blank" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> 预览</a>'
      + '<span class="text-muted" style="font-size:.75rem;word-break:break-all">' + escLib(it.file_original_name || '') + '</span></div>';
  }
  if (it.content) {
    h += '<div class="text-primary mt-2" style="font-size:.8rem;cursor:pointer" onclick="showLibContent(' + it.id + ')"><i class="bi bi-file-text"></i> 查看全部内容 <i class="bi bi-arrow-right"></i></div>';
  }
  h += '<div class="text-muted mt-1" style="font-size:.75rem">' + escLib(it.creator_name || '') + ' · ' + dateStr + '</div>';
  h += '</div></div></div>';
  return h;
}

function loadLibrary() {
  var key = document.getElementById('libFilterKey').value.trim().toLowerCase();
  var sf = libItems.filter(function(it) {
    if (key && (it.title||'').toLowerCase().indexOf(key) < 0 && (it.content||'').toLowerCase().indexOf(key) < 0) return false;
    return true;
  });
  renderLibPills(sf);

  /* 按配置分类分组，配置外的孤儿分类追加为灰色分组 */
  var sections = [];
  libCats.forEach(function(c) {
    sections.push({ name: c, color: libCatColors[c] || '#6c757d', items: sf.filter(function(it) { return it.category === c; }) });
  });
  var seen = {};
  libCats.forEach(function(c) { seen[c] = true; });
  sf.forEach(function(it) {
    var c = it.category || '未分类';
    if (!seen[c]) {
      seen[c] = true;
      sections.push({ name: c, color: libCatColors[c] || '#6c757d', items: sf.filter(function(x) { return (x.category || '未分类') === c; }) });
    }
  });

  var html = '', shown = 0;
  sections.forEach(function(s) {
    if (libFilterCat && s.name !== libFilterCat) return;
    if (key && !s.items.length && libFilterCat !== s.name) return;
    shown++;
    var collapsed = !!libCollapsed[s.name];
    var grid;
    if (s.items.length) {
      grid = '<div class="row g-2 lib-sec-grid mt-2' + (collapsed ? ' d-none' : '') + '">' + s.items.map(libItemCard).join('') + '</div>';
    } else {
      grid = '<div class="text-muted text-center py-3 lib-sec-grid' + (collapsed ? ' d-none' : '') + '" style="font-size:.85rem">该分类暂无条目</div>';
    }
    html += '<div class="lib-section' + (collapsed ? ' collapsed' : '') + '" data-cat="' + escLib(s.name) + '">'
      + '<div class="card lib-sec-head" style="border-left:4px solid ' + s.color + '" onclick="toggleLibSection(this)">'
      + '<div class="card-body d-flex align-items-center gap-2 py-2 px-3">'
      + '<i class="bi bi-chevron-down lib-sec-chevron"></i>'
      + '<span class="lib-sec-dot" style="background:' + s.color + '"></span>'
      + '<strong>' + escLib(s.name) + '</strong>'
      + '<span class="lib-sec-cnt">' + s.items.length + ' 条</span>'
      + (canEditLib ? '<span class="ms-auto"><button type="button" class="btn btn-ico btn-ico-sm btn-primary" title="在此分类新增" onclick="event.stopPropagation();openLibModal(null, this.closest(\'.lib-section\').dataset.cat)"><i class="bi bi-plus-lg"></i></button></span>' : '')
      + '</div></div>'
      + grid
      + '</div>';
  });
  if (!shown) {
    html = libItems.length === 0
      ? '<div class="text-center text-muted py-5"><i class="bi bi-inbox" style="font-size:2rem"></i><p class="mt-2">暂无记录</p></div>'
      : '<div class="text-center text-muted py-5"><i class="bi bi-search" style="font-size:2rem"></i><p class="mt-2">无匹配结果</p></div>';
  }
  document.getElementById('libList').innerHTML = html;
}

function toggleLibSection(el) {
  var sec = el.closest('.lib-section'); if (!sec) return;
  var collapsed = !sec.classList.contains('collapsed');
  sec.classList.toggle('collapsed', collapsed);
  var grid = sec.querySelector('.lib-sec-grid'); if (grid) grid.classList.toggle('d-none', collapsed);
  try {
    var st = JSON.parse(localStorage.getItem('libCollapsed') || '{}') || {};
    st[sec.dataset.cat] = collapsed;
    localStorage.setItem('libCollapsed', JSON.stringify(st));
  } catch (e) { /* 忽略存储异常 */ }
}

function openLibModal(item, presetCat) {
  document.getElementById('libEditId').value = item ? item.id : '';
  document.getElementById('libTitle').value = item ? item.title : '';
  document.getElementById('libCategory').value = item ? item.category : (presetCat && libCats.indexOf(presetCat) >= 0 ? presetCat : '法律法规');
  document.getElementById('libFile').value = '';
  document.getElementById('libModalTitle').textContent = item ? '编辑' : '新增';
  var modal = new bootstrap.Modal(document.getElementById('libModal'));
  modal.show();
  document.getElementById('libModal').addEventListener('shown.bs.modal', function onShown() {
    document.getElementById('libModal').removeEventListener('shown.bs.modal', onShown);
    initQuill();
    if (quillInstance) {
      if (item && item.content) {
        if (item.content.trim().charAt(0) === '<') {
          quillInstance.root.innerHTML = item.content;
        } else if (typeof marked !== 'undefined') {
          quillInstance.root.innerHTML = marked.parse(item.content);
        } else {
          quillInstance.root.textContent = item.content;
        }
      } else {
        quillInstance.setText('');
      }
    }
  });
}

function editLibItem(id) {
  var it = libItems.find(function(x) { return x.id === id; });
  if (it) openLibModal(it);
}

function showLibContent(id) {
  var it = libItems.find(function(x) { return x.id === id; });
  if (!it || !it.content) return;
  document.getElementById('libContentModalTitle').textContent = it.title || '内容详情';
  document.getElementById('libContentModalBody').innerHTML = renderContent(it.content);
  new bootstrap.Modal(document.getElementById('libContentModal')).show();
}

async function saveLibItem() {
  var id = document.getElementById('libEditId').value;
  var title = document.getElementById('libTitle').value.trim();
  var category = document.getElementById('libCategory').value;
  var content = quillInstance ? quillInstance.root.innerHTML.trim() : '';
  if (content === '<p><br></p>' || content === '<br>') content = '';
  var file = document.getElementById('libFile').files[0];
  if (!title) return toast('标题不能为空', 'danger');
  if (!category) return toast('请选择分类', 'danger');
  var fd = new FormData();
  fd.append('title', title);
  fd.append('category', category);
  fd.append('content', content);
  if (file) fd.append('file', file);
  var csrf = getCsrfToken();
  if (csrf) fd.append('_csrf', csrf);
  var btn = document.getElementById('libSaveBtn');
  btn.disabled = true;
  try {
    var url = id ? '/api/library/' + id : '/api/library';
    var method = id ? 'PUT' : 'POST';
    var res = await fetch(url, { method: method, body: fd, headers: csrf ? { 'x-csrf-token': csrf } : {} });
    var data = await res.json();
    if (!res.ok) throw new Error(data.error || '保存失败');
    toast('保存成功', 'success');
    bootstrap.Modal.getInstance(document.getElementById('libModal')).hide();
    var res2 = await fetch('/api/library');
    var d2 = await res2.json();
    libItems = d2.items;
    loadLibrary();
  } catch (e) { toast(e.message, 'danger'); }
  btn.disabled = false;
}

async function deleteLibItem(id) {
  var it = libItems.find(function(x) { return x.id === id; });
  if (!confirm('确定删除「' + (it ? it.title : '') + '」？此操作不可撤销。')) return;
  try {
    var csrf = getCsrfToken();
    var res = await fetch('/api/library/' + id, { method: 'DELETE', headers: csrf ? { 'x-csrf-token': csrf } : {} });
    var data = await res.json();
    if (!res.ok) throw new Error(data.error || '删除失败');
    toast('已删除', 'success');
    libItems = libItems.filter(function(x) { return x.id !== id; });
    loadLibrary();
  } catch (e) { toast(e.message, 'danger'); }
}
</script>
